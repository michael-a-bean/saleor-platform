{
  "enabledPlugins": {
    "local-review@agent37-skills": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-pr-lint.sh",
            "timeout": 120000
          }
        ]
      }
    ]
  }
}
