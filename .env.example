# =============================================================================
# Saleor Platform Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values.
# All variables marked REQUIRED must be set for the platform to start.
#
# SECURITY WARNING: Never commit .env files. They are in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Platform Core (Saleor API)
# -----------------------------------------------------------------------------

# REQUIRED: Django secret key (generate with: openssl rand -hex 32)
SECRET_KEY=

# REQUIRED: PostgreSQL connection string for Saleor database
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://saleor:saleor@db/saleor

# REQUIRED: PostgreSQL user and password (for db container)
POSTGRES_USER=saleor
POSTGRES_PASSWORD=saleor

# REQUIRED: Redis/Valkey connection for cache
CACHE_URL=redis://cache:6379/0

# REQUIRED: Celery broker URL (typically same as cache)
CELERY_BROKER_URL=redis://cache:6379/1

# Email configuration (for development, Mailpit is used)
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_URL=smtp://mailpit:1025

# Default channel slug (must exist in Saleor)
DEFAULT_CHANNEL_SLUG=webstore

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=saleor
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# -----------------------------------------------------------------------------
# Custom Apps - Secret Keys
# -----------------------------------------------------------------------------
# Each app requires its own secret key for encryption.
# Generate with: openssl rand -hex 32

# REQUIRED: Stripe payment app secret key
STRIPE_APP_SECRET_KEY=

# REQUIRED: Inventory operations app secret key
INVENTORY_OPS_SECRET_KEY=

# REQUIRED: Buylist app secret key
BUYLIST_SECRET_KEY=

# REQUIRED: Point of Sale app secret key
POS_SECRET_KEY=

# REQUIRED: MTG Import app secret key
MTG_IMPORT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Custom Apps - Database
# -----------------------------------------------------------------------------

# REQUIRED: Inventory ops database connection string
# This database is shared by inventory-ops, buylist, and pos apps
INVENTORY_DATABASE_URL=postgresql://inventory:inventory@inventory-ops-db:5432/inventory_ops

# REQUIRED: Inventory database user and password (for inventory-ops-db container)
INVENTORY_POSTGRES_USER=inventory
INVENTORY_POSTGRES_PASSWORD=inventory

# -----------------------------------------------------------------------------
# Custom Apps - External Services
# -----------------------------------------------------------------------------

# Stripe integration (for payment processing)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Scryfall API (for MTG card data)
SCRYFALL_API_BASE_URL=https://api.scryfall.com
SCRYFALL_RATE_LIMIT_MS=100

# -----------------------------------------------------------------------------
# Price Sync Worker
# -----------------------------------------------------------------------------

# Saleor app installation ID (get from Dashboard after installing app)
# This is optional for local development
# INSTALLATION_ID=

# Saleor database URL for direct access (read operations)
SALEOR_DATABASE_URL=postgresql://saleor:saleor@db:5432/saleor

# Channel ID for price sync
SALEOR_CHANNEL_ID=webstore

# Batch size for price sync operations
BATCH_SIZE=100

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Search (Meilisearch)
# -----------------------------------------------------------------------------

# Meilisearch configuration
MEILISEARCH_URL=http://meilisearch:7700

# Meilisearch master key (optional for development, REQUIRED for production)
# MEILISEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Storefront
# -----------------------------------------------------------------------------

# Public Saleor API URL (with trailing slash)
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8000/graphql/

# Public storefront URL
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Default channel for storefront
NEXT_PUBLIC_DEFAULT_CHANNEL=webstore

# -----------------------------------------------------------------------------
# Environment Identification
# -----------------------------------------------------------------------------

# REQUIRED: Environment identifier for isolation validation
# Values: local | staging | production
# This is used by validation scripts to prevent cross-environment contamination
SALEOR_ENVIRONMENT=local

# Build environment for storefront (baked into Docker image)
# Values: local | staging | production
NEXT_PUBLIC_BUILD_ENV=local

# -----------------------------------------------------------------------------
# Development Settings (DO NOT USE IN PRODUCTION)
# -----------------------------------------------------------------------------

# Allow loopback IPs for local development
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True

# Disable IP filtering for local apps development
HTTP_IP_FILTER_ENABLED=False
