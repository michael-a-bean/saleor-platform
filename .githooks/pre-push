#!/bin/bash
# =============================================================================
# Git Pre-Push Hook
# =============================================================================
#
# Validates environment isolation before pushing to remote.
# Prevents accidental pushes of local configurations to staging/production.
#
# Installation:
#   make setup-hooks
#   # or manually:
#   git config core.hooksPath .githooks
#
# Bypass (use sparingly):
#   git push --no-verify
#
# =============================================================================

set -e

# Get the current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# =============================================================================
# Branch Protection
# =============================================================================

# Block direct pushes to protected branches
if [ "$BRANCH" = "main" ]; then
    echo "=========================================="
    echo "ERROR: Direct push to 'main' is prohibited"
    echo "=========================================="
    echo ""
    echo "The 'main' branch mirrors upstream saleor/saleor-platform."
    echo "Use 'platform/main' for your changes."
    echo ""
    echo "To switch branches:"
    echo "  git checkout platform/main"
    echo "  git cherry-pick <your-commit>"
    echo ""
    exit 1
fi

if [ "$BRANCH" = "master" ]; then
    echo "ERROR: Direct push to 'master' is prohibited"
    exit 1
fi

# =============================================================================
# Submodule Validation
# =============================================================================

# Ensure all submodule pointers (including nested) reference commits
# that exist on their remotes. Prevents pushing commits that CI can't check out.
echo "Checking submodule references..."

check_submodule_refs() {
    local base_dir="$1"
    local error=0

    while IFS= read -r line; do
        # Format: "<status><sha> <path> (<describe>)"
        SHA=$(echo "$line" | awk '{print $1}' | sed 's/^[+ -]*//')
        SUBPATH=$(echo "$line" | awk '{print $2}')

        if [ -z "$SHA" ] || [ -z "$SUBPATH" ]; then
            continue
        fi

        local full_path="${base_dir:+$base_dir/}$SUBPATH"

        if ! git -C "$full_path" branch -r --contains "$SHA" >/dev/null 2>&1; then
            echo ""
            echo "=========================================="
            echo "ERROR: Submodule '$full_path' references"
            echo "  commit $SHA"
            echo "  which has NOT been pushed to its remote."
            echo "=========================================="
            echo ""
            echo "Fix: cd $full_path && git push origin HEAD:main"
            echo ""
            error=1
        fi

        # Recursively check nested submodules
        if [ -f "$full_path/.gitmodules" ]; then
            if ! (cd "$full_path" && check_submodule_refs ""); then
                error=1
            fi
        fi
    done < <(git -C "${base_dir:-.}" submodule status 2>/dev/null)

    return $error
}

if ! check_submodule_refs ""; then
    echo "Push submodule commits first, then retry."
    exit 1
fi

echo "[OK] All submodule references exist on remotes"

# =============================================================================
# Environment Validation
# =============================================================================

# Run environment validation script if it exists
SCRIPT_PATH="./scripts/validate-environment.sh"

if [ -x "$SCRIPT_PATH" ]; then
    echo "Running environment validation..."
    if ! "$SCRIPT_PATH" pre-push; then
        echo ""
        echo "=========================================="
        echo "Pre-push validation FAILED"
        echo "=========================================="
        echo ""
        echo "Fix the issues above before pushing."
        echo "Or bypass with: git push --no-verify (not recommended)"
        echo ""
        exit 1
    fi
else
    echo "[WARN] validate-environment.sh not found or not executable"
    echo "       Run 'chmod +x scripts/validate-environment.sh' to enable"
fi

# =============================================================================
# Success
# =============================================================================

echo ""
echo "[OK] Pre-push validation passed"
exit 0
