CACHE_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1
# DATABASE_URL is set via docker-compose.yml environment section
# to enable variable interpolation from .env
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_URL=smtp://mailpit:1025
# SECRET_KEY is set via .env file - do not hardcode here
# This file is loaded via env_file; SECRET_KEY must be in root .env
# OpenTelemetry Configuration
# Option A: Grafana Cloud (recommended for staging/production)
OTEL_SERVICE_NAME=saleor
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-west-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS is set in .env (gitignored) — contains Grafana Cloud auth
# Option B: Local Jaeger (uncomment below, comment above endpoint)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
