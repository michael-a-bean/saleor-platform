{
    "RoleName": "saleor-platform-staging-ecs-execution",
    "PolicyName": "secrets-access",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "ssm:GetParameters",
                    "ssm:GetParameter"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:ssm:us-west-1:546464732019:parameter/saleor/staging/*",
                "Sid": "SSMSecrets"
            },
            {
                "Action": "secretsmanager:GetSecretValue",
                "Effect": "Allow",
                "Resource": "arn:aws:secretsmanager:us-west-1:546464732019:secret:saleor/staging/*",
                "Sid": "SecretsManager"
            },
            {
                "Action": "kms:Decrypt",
                "Condition": {
                    "StringEquals": {
                        "kms:ViaService": "ssm.us-west-1.amazonaws.com"
                    }
                },
                "Effect": "Allow",
                "Resource": "*",
                "Sid": "KMSDecrypt"
            }
        ]
    }
}
