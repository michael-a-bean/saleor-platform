# S3 Backend Configuration Template
#
# IMPORTANT: Copy this file to backend.tf and fill in your values.
# The S3 bucket and DynamoDB table must be created manually first.
#
# Manual setup steps (see docs/runbooks/terraform-setup.md):
# 1. Create S3 bucket: saleor-platform-tfstate-{account_id}
# 2. Enable versioning on the bucket
# 3. Enable server-side encryption (SSE-S3 or SSE-KMS)
# 4. Create DynamoDB table: saleor-platform-tfstate-lock
#    - Primary key: LockID (String)
#    - Billing: On-demand

terraform {
  backend "s3" {
    bucket         = "saleor-platform-tfstate-ACCOUNT_ID"
    key            = "ENV/terraform.tfstate"  # Replace ENV with staging or production
    region         = "us-west-2"
    encrypt        = true
    dynamodb_table = "saleor-platform-tfstate-lock"

    # Optional: Use KMS for enhanced encryption
    # kms_key_id = "alias/terraform-state"
  }
}
