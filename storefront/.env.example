# Saleor GraphQL API URL (keep the trailing slash)
# For local Docker development:
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8000/graphql/
# For production, use your deployed Saleor instance:
# NEXT_PUBLIC_SALEOR_API_URL=https://your-saleor-instance.com/graphql/

# Storefront URL (used for canonical URLs and SSR)
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Default channel slug - must match a channel configured in Saleor
NEXT_PUBLIC_DEFAULT_CHANNEL=webstore

# Saleor App Token (optional - for authenticated channel fetching)
SALEOR_APP_TOKEN=

# Meilisearch configuration (for singles-builder search)
MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=  # Set this if you configured a master key
